# Copy to .env to override defaults. Every key is optional; defaults are in src/cof/common/settings.py.
# Directories (absolute, or relative to where you run the command)
# COF_ACQUIRE_DIR=data/acquire
# COF_ORIGINALS_DIR=data/originals
# COF_NORMALIZED_DIR=data/normalized
# COF_ANALYSIS_DIR=data/original_analysis
# COF_CORPUS_DIR=../previews_parsing/cof_files
# COF_CONFIG_DIR=config

# Politeness and robustness for requests to web.archive.org
# COF_WAYBACK_DELAY=2.0
# COF_WAYBACK_RETRIES=5
# COF_WAYBACK_TIMEOUT=120
# COF_LISTING_EVERY_DAYS=90
